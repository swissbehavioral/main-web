# ---------------------------------------------------------------------------
# Swiss Behavioral Health — environment configuration
# Copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Admin session signing (required in production) ------------------------
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Admin authentication -------------------------------------------------
# Development only: shared password for an isolated local workspace.
# If ADMIN_EMAIL is set, the login form requires that email as well.
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=

# Production requires individual Appwrite Auth users.
# Requires the Appwrite variables below, and an admin user to exist.
APPWRITE_AUTH_ENABLED=true

# --- Appwrite backend -----------------------------------------------------
# Server-side SDK credentials. Required in production; never use VITE_ prefixes.
# Cloud endpoint: https://cloud.appwrite.io/v1
# Self-hosted:    https://appwrite.your-domain.com/v1
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Optional overrides (defaults shown)
APPWRITE_DATABASE_ID=sbh
APPWRITE_LEADS_COLLECTION_ID=leads

# --- Appwrite setup script only (scripts/appwrite-setup.mjs) --------------
# Used once to create the schema and (optionally) the first admin user.
APPWRITE_ADMIN_EMAIL=
APPWRITE_ADMIN_PASSWORD=
APPWRITE_ADMIN_NAME=SBH Admin

# --- Optional: local file store location ----------------------------------
# Development only, when Appwrite is not configured.
# LEADS_DIR=/absolute/path/to/storage

# Production public origin and reverse proxy
PUBLIC_ORIGIN=https://www.swissbehavioralhealth.com
# Set only for a trusted reverse proxy directly in front of this process.
# TRUST_PROXY=loopback
HOST=127.0.0.1
PORT=3000
