{
  "name": "swissbehavioralhealth",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "node server.mjs",
    "start:env": "node --env-file=.env server.mjs",
    "typecheck": "react-router typegen && tsc",
    "setup:appwrite": "node --env-file=.env scripts/appwrite-setup.mjs",
    "setup:content": "node --env-file=.env scripts/appwrite-content-setup.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/test-page-layout.mjs",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "preview:cloudflare": "wrangler dev",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-router/express": "^7.18.4",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "appwrite": "^29.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.22.3",
    "isbot": "^5.1.36",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "node-appwrite": "^30.0.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.152.0"
  }
}
